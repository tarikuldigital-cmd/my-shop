# true = use src/mocks/*.json ; false = call the Laravel REST API
VITE_USE_MOCK=true
# Laravel API base (e.g. https://bookshelf.com.bd/api/v1)
VITE_API_BASE_URL=https://bookshelf.com.bd/api/v1
# Where product/category/banner images are served from
VITE_ASSET_BASE_URL=https://bookshelf.com.bd/public/uploads
