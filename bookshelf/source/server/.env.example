# Copy to .env and fill in. Same SMS settings as the Bachelor Home project's server/.env.
PORT=4100

# SMS gateway: muthofun | bulksmsbd | template | none
SMS_PROVIDER=muthofun
# Muthofun: the full key from the Muthobarta panel, e.g. Token abc123...
SMS_API_KEY=
# Optional for Muthofun, required for BulkSMSBD
SMS_SENDER_ID=
# Any other gateway (SMS_PROVIDER=template):
# SMS_URL_TEMPLATE=https://gateway.com/send?key=XXX&to={number}&msg={message}

# Long random text; paste the same value in Admin → SMS → Admin secret
ADMIN_SECRET=
# Websites allowed to use this relay (comma separated)
ALLOWED_ORIGIN=https://bookshelf.com.bd,https://tarikuldigital-cmd.github.io
# Live website address — order SMS must contain a tracking link to it
SITE_URL=https://bookshelf.com.bd

# ---- AI live chat (optional; can also be set from Admin → Live chat → "Save to server") ----
# Any OpenAI-compatible provider. Free options: Groq, Google Gemini, OpenRouter (":free" models)
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
# CHAT_API_KEY=
# CHAT_DAILY_CAP=1500
