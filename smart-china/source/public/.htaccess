# Bookshelf — React single-page app on Apache / cPanel shared hosting.
# Upload the contents of dist/ (including this file) to public_html/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # keep real files/folders (assets, favicon, /sms, /api …) as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^(api|sms|chat)/ - [L]
  # everything else is a storefront/admin route handled by React Router
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
